#!/system/bin/sh
# Headless ROM boot script (after 10-apps): make Termux reachable over SSH.
# First boot: unpack Termux's base system (Termux only does that from its
# visible UI, so start it once), add the ROM's authorized SSH keys and set the
# default password "changeme", which the first SSH login must change. Then,
# in the background: install openssh as soon as the network allows, and keep
# sshd (port 8022, Termux user, key or password login) running.
# Log: /data/local/termux-setup.log

T=/data/data/com.termux
P=$T/files/usr
H=$T/files/home

if ! pm path com.termux >/dev/null 2>&1; then
    echo "20-termux: Termux is not installed"
    exit 0
fi

# Termux unpacks its base system only while its activity is visible: with
# anything else on top it gives up and finishes. So go home first, start it,
# and retry. The installer unpacks into usr-staging and renames it to usr.
tries=0
while [ ! -x "$P/bin/bash" ] && [ $tries -lt 3 ]; do
    tries=$((tries + 1))
    echo "20-termux: unpacking Termux's base system (starting its UI, attempt $tries)"
    input keyevent KEYCODE_WAKEUP
    wm dismiss-keyguard 2>/dev/null
    input keyevent KEYCODE_HOME
    am start -W -n com.termux/.app.TermuxActivity >/dev/null 2>&1
    i=0 # 60 s to start unpacking, then up to 240 s to finish
    while [ ! -x "$P/bin/bash" ] && { [ $i -lt 60 ] || { [ -d "$T/files/usr-staging" ] && [ $i -lt 300 ]; }; }; do
        sleep 2
        i=$((i + 2))
    done
done
if [ ! -x "$P/bin/bash" ]; then
    echo "20-termux: Termux's base system did not appear after $tries attempts"
    exit 1
fi
[ $tries -gt 0 ] && echo "20-termux: base system unpacked (attempt $tries)"

# Termux:Boot runs ~/.termux/boot scripts only after it was opened once.
if dumpsys package com.termux.boot 2>/dev/null | grep -q "stopped=true"; then
    am start -W -n com.termux.boot/.BootActivity >/dev/null 2>&1
    sleep 2
    echo "20-termux: opened Termux:Boot once"
fi
input keyevent KEYCODE_HOME

# Authorized keys from the ROM (the build host's key, if the build had one),
# merged into ~/.ssh/authorized_keys.
TU=$(stat -c %u "$T")
mkdir -p "$H/.ssh"
touch "$H/.ssh/authorized_keys"
KEYS=/system/etc/headless/termux_authorized_keys
if [ -f "$KEYS" ]; then
    while read -r key; do
        [ -n "$key" ] && ! grep -qxF "$key" "$H/.ssh/authorized_keys" && echo "$key" >>"$H/.ssh/authorized_keys"
    done <"$KEYS"
fi
chown -R "$TU:$TU" "$H/.ssh"
chmod 700 "$H/.ssh"
chmod 600 "$H/.ssh/authorized_keys"

# Password login: termux-auth keeps a PBKDF2 hash in ~/.termux_authinfo. Until
# one exists, use the ROM's default ("changeme"); the profile.d hook makes
# the first interactive SSH login replace it.
if [ ! -f "$H/.termux_authinfo" ]; then
    cp /system/etc/headless/termux_default_authinfo "$H/.termux_authinfo"
    chown "$TU:$TU" "$H/.termux_authinfo"
    chmod 600 "$H/.termux_authinfo"
    echo "20-termux: default password set"
fi
cp /system/etc/headless/termux-first-login.sh "$P/etc/profile.d/headless-first-login.sh"
chown "$TU:$TU" "$P/etc/profile.d/headless-first-login.sh"
chmod 644 "$P/etc/profile.d/headless-first-login.sh"
restorecon -R "$H/.ssh" "$H/.termux_authinfo" "$P/etc/profile.d/headless-first-login.sh" 2>/dev/null

setsid sh /system/etc/headless/termux-sshd.sh "$TU" </dev/null >/dev/null 2>&1 &
echo "20-termux: sshd supervisor started (log /data/local/termux-setup.log)"
