#!/system/bin/sh
# Headless ROM boot script (run by headless_boot before /data/local/boot.d):
# install the apps bundled in /system/etc/headless/apps if they are missing,
# and give them, and every installed com.termux* plugin, all permissions they
# request without asking. Runs at every boot, so updated apps and anything
# Android resets get the same treatment again.

APPS=/system/etc/headless/apps

# Android-wide: no permission auto-revoke / hibernation of unused apps, no
# phantom process killer (it kills Termux's child processes), no lock screen
# (headless; Termux also needs a visible UI once to unpack itself).
device_config put app_hibernation app_hibernation_enabled false
device_config put permissions auto_revoke_unused_threshold_millis2 3153600000000
device_config put activity_manager max_phantom_processes 2147483647
settings put global settings_enable_monitor_phantom_procs false
locksettings set-disabled true >/dev/null 2>&1

installed() { pm path "$1" >/dev/null 2>&1; }

# Bundled APKs are named <package>.apk.bin. com.termux goes first: the
# plugins share its user id.
bundled=$(ls "$APPS" 2>/dev/null | sed -n 's/\.apk\.bin$//p' | sort |
    awk '$0 == "com.termux" { print; next } { rest = rest $0 "\n" } END { printf "%s", rest }')
for pkg in $bundled; do
    installed "$pkg" && continue
    tmp=/data/local/tmp/headless-install.apk # pm wants a readable .apk path
    cp "$APPS/$pkg.apk.bin" "$tmp" && chmod 644 "$tmp"
    # Termux:Boot still has to be opened once to get BOOT_COMPLETED; 20-termux
    # does that after Termux has unpacked, since its screen on top makes
    # Termux give up unpacking.
    if out=$(pm install -g --user 0 "$tmp" 2>&1); then
        echo "10-apps: installed $pkg"
    else
        echo "10-apps: installing $pkg failed: $out"
    fi
    rm -f "$tmp"
done

# Special access that is an app-op or a setting rather than a runtime permission.
special() { # $1 package, $2 permission
    case $2 in
    android.permission.SYSTEM_ALERT_WINDOW) appops set "$1" SYSTEM_ALERT_WINDOW allow ;;
    android.permission.MANAGE_EXTERNAL_STORAGE) appops set --uid "$1" MANAGE_EXTERNAL_STORAGE allow ;;
    android.permission.REQUEST_INSTALL_PACKAGES) appops set "$1" REQUEST_INSTALL_PACKAGES allow ;;
    android.permission.WRITE_SETTINGS) appops set "$1" WRITE_SETTINGS allow ;;
    android.permission.SCHEDULE_EXACT_ALARM) appops set "$1" SCHEDULE_EXACT_ALARM allow ;;
    android.permission.PACKAGE_USAGE_STATS) appops set "$1" GET_USAGE_STATS allow ;;
    android.permission.MANAGE_MEDIA) appops set "$1" MANAGE_MEDIA allow ;;
    android.permission.ACCESS_NOTIFICATION_POLICY) cmd notification allow_dnd "$1" ;;
    esac
}

listeners=$(cmd package query-services --components -a android.service.notification.NotificationListenerService 2>/dev/null)
targets=$( { echo "$bundled"; pm list packages | sed -n 's/^package://p' | grep '^com\.termux'; } | sort -u)
for pkg in $targets; do
    installed "$pkg" || continue
    n=0
    for perm in $(dumpsys package "$pkg" 2>/dev/null | awk '/^    requested permissions:/ { f = 1; next }
            f && /^      [A-Za-z0-9_.]+/ { sub(/^ +/, ""); sub(/[: ].*/, ""); print; next } f { exit }'); do
        pm grant "$pkg" "$perm" 2>/dev/null && n=$((n + 1))
        special "$pkg" "$perm" 2>/dev/null
    done
    for c in $(echo "$listeners" | grep "^$pkg/"); do cmd notification allow_listener "$c" 2>/dev/null; done
    # Never restrict in the background, never auto-revoke, no battery optimisation.
    appops set --uid "$pkg" AUTO_REVOKE_PERMISSIONS_IF_UNUSED ignore 2>/dev/null
    appops set "$pkg" RUN_IN_BACKGROUND allow 2>/dev/null
    appops set "$pkg" RUN_ANY_IN_BACKGROUND allow 2>/dev/null
    dumpsys deviceidle whitelist +"$pkg" >/dev/null 2>&1
    am set-standby-bucket "$pkg" active 2>/dev/null
    echo "10-apps: $pkg: $n runtime permissions granted, special access and battery exemptions set"
done
