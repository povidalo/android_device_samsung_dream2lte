#!/system/bin/sh
# Headless ROM boot script: snapshot the USB devices, serial ports, disks and
# network 60 s and 300 s after boot into /data/local/usb-boot.log (one block per
# snapshot, newest last, world-readable), to compare what came up across boots.

LOG=/data/local/usb-boot.log

snapshot() {
    echo "=== $(date '+%F %T') uptime $(cut -d' ' -f1 /proc/uptime)s"
    for d in /sys/bus/usb/devices/*; do
        [ -f "$d/idVendor" ] || continue
        echo "$(basename "$d") $(cat "$d/idVendor"):$(cat "$d/idProduct") $(cat "$d/speed")M $(cat "$d/manufacturer" 2>/dev/null) $(cat "$d/product" 2>/dev/null)"
    done
    echo "ttys: $(ls /dev/ttyACM* /dev/ttyUSB* 2>/dev/null | tr '\n' ' ')"
    echo "disks: $(ls /sys/block | grep -E '^sd[e-z]' | tr '\n' ' ')"
    echo "net: $(ip -br addr | grep -E '^(eth|wlan)' | tr -s ' ' | tr '\n' ';')"
    echo "usb-c: $(dumpsys usb | grep -m1 current_mode | tr -d ' ') ccic_state=$(cat /sys/class/sec/ccic/state 2>/dev/null)"
}

(
    sleep 60
    snapshot >>"$LOG" 2>&1
    sleep 240
    snapshot >>"$LOG" 2>&1
    tail -n 3000 "$LOG" >"$LOG.tmp" && mv -f "$LOG.tmp" "$LOG"
    chmod 644 "$LOG"
) </dev/null >/dev/null 2>&1 &
