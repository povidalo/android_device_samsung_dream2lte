// Headless server: the ROM's own boot scripts, run by headless_boot (see
// headless_su/headless_boot.sh) from /system/etc/headless/boot.d before the
// user's /data/local/boot.d, plus the files they use.

// Wi-Fi country code override (SG: all 2.4 and 5 GHz channels).
prebuilt_etc {
    name: "headless_boot_05-wifi-country",
    src: "boot.d/05-wifi-country",
    sub_dir: "headless/boot.d",
    filename: "05-wifi-country",
}

// Installs the APKs bundled in /system/etc/headless/apps (see device.mk) and
// grants them everything they request.
prebuilt_etc {
    name: "headless_boot_10-apps",
    src: "boot.d/10-apps",
    sub_dir: "headless/boot.d",
    filename: "10-apps",
}

prebuilt_etc {
    name: "headless_boot_20-termux",
    src: "boot.d/20-termux",
    sub_dir: "headless/boot.d",
    filename: "20-termux",
}

prebuilt_etc {
    name: "headless_boot_30-usb-report",
    src: "boot.d/30-usb-report",
    sub_dir: "headless/boot.d",
    filename: "30-usb-report",
}

// USB-C role watcher, run by the init service headless_usb_role (sud.rc):
// re-attaches the port in the other role when the current role does not work.
prebuilt_etc {
    name: "headless_usb_role_watch",
    src: "usb-role-watch.sh",
    sub_dir: "headless",
    filename: "usb-role-watch.sh",
}

// sshd supervisor started by 20-termux.
prebuilt_etc {
    name: "headless_termux_sshd",
    src: "termux-sshd.sh",
    sub_dir: "headless",
    filename: "termux-sshd.sh",
}

// termux-auth hash (PBKDF2-HMAC-SHA1, salt "Termux!", 65536 rounds, 20 bytes)
// of the default Termux password "changeme", installed by 20-termux until the
// user sets one. Regenerate with:
//   python3 -c "import hashlib,sys; open(sys.argv[1],'wb').write(hashlib.pbkdf2_hmac('sha1', b'changeme', b'Termux!', 65536, 20))" termux_default_authinfo
prebuilt_etc {
    name: "headless_termux_default_authinfo",
    src: "termux_default_authinfo",
    sub_dir: "headless",
    filename: "termux_default_authinfo",
}

// profile.d hook (copied into Termux by 20-termux): the first interactive SSH
// login must replace the default password.
prebuilt_etc {
    name: "headless_termux_first_login",
    src: "termux-first-login.sh",
    sub_dir: "headless",
    filename: "termux-first-login.sh",
}

// The SSH public keys allowed to log in (termux_authorized_keys) are not in git:
// the Mac build script copies the build host's key in before every build, and
// device.mk installs the file only if it exists.
