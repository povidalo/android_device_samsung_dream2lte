# headless_su root daemon. Headless single-user server: any caller that knows
# the root password gets root (no per-app permission management). The daemon
# and the root shells it spawns run in the permissive 'sud' domain; everything
# else stays enforcing.
#
# Note: the su_exec rules below deliberately break AOSP's neverallow in
# public/domain.te (only shell/su/dumpstate may execute su_exec). The build
# accepts them because universal8895-common sets SELINUX_IGNORE_NEVERALLOWS.
type sud, domain, coredomain, mlstrustedsubject, mlstrustedobject;
permissive sud;

# init starts /system/xbin/su (su_exec) with 'seclabel u:r:sud:s0'.
allow init su_exec:file { getattr open read execute map };
allow init sud:process { transition rlimitinh siginh noatsecure };
allow sud su_exec:file { entrypoint getattr open read execute map };

# Clients: any app (Termux), adb shell and su may run the client and reach
# the daemon's abstract socket @headless_su.
allow appdomain su_exec:file { getattr open read execute execute_no_trans map };
allow { appdomain shell su } sud:unix_stream_socket connectto;

# su/set_root_pwd may manage the password store /data/misc/headless_su/
# (passwd + lock, root-only, mode 0600). /data is system_data_root_file;
# /data/misc and below default to system_data_file.
allow sud system_data_root_file:dir search;
allow sud system_data_file:dir create_dir_perms;
allow sud system_data_file:file create_file_perms;

# set_root_pwd (/system/xbin/set_root_pwd, a system_file) is run from the sud shell.
allow sud system_file:file { getattr open read execute execute_no_trans map };
