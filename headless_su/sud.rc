# Root daemon for headless_su (/system/bin/su). Grants root to callers that
# know the root password (default "root" until set_root_pwd sets one).
service sud /system/bin/su --daemon
    class main
    user root
    group root
    seclabel u:r:sud:s0

# Root boot scripts in /data/local/boot.d, run once boot has completed (see
# headless_boot). Not oneshot: the runner stays alive so that init does not
# kill the daemons the scripts start. oom_score_adj 0 (inherited by those
# daemons) instead of init's -1000, so the kernel may OOM-kill a runaway one.
service headless_boot /system/bin/headless_boot
    user root
    group root
    seclabel u:r:sud:s0
    oom_score_adjust 0
    disabled

on property:sys.boot_completed=1
    start headless_boot

# USB-C role watcher (/system/etc/headless/usb-role-watch.sh): re-attaches the
# port in the other role when the role it came up in does not work. Started
# early (data is mounted by "on boot"), because the wrong role shows up ~30 s
# after power-on, well before boot completes.
service headless_usb_role /system/bin/sh /system/etc/headless/usb-role-watch.sh
    user root
    group root
    seclabel u:r:sud:s0
    disabled

on boot
    start headless_usb_role
